{
    "name": "open-framer-sync",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Open-source Framer CMS sync — connect any REST/JSON API (and OpenCMS) to a Framer CMS collection.",
    "engines": {
        "node": ">=20.19"
    },
    "scripts": {
        "build": "vite build",
        "check": "npm run check-typescript && npm run check-eslint",
        "dev": "vite",
        "format": "prettier --write .",
        "check-eslint": "eslint --max-warnings 0 .",
        "check-prettier": "prettier --check .",
        "check-typescript": "tsc",
        "preview": "vite preview"
    },
    "dependencies": {
        "@framer/plugin": "^4",
        "@tiptap/extension-image": "^3",
        "@tiptap/extension-link": "^3",
        "@tiptap/html": "^3",
        "@tiptap/starter-kit": "^3",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.35.0",
        "@types/react": "^18.3.24",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^6.0.1",
        "eslint": "^9.35.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.20",
        "globals": "^16.4.0",
        "prettier": "^3.6.2",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.44.0",
        "vite": "^8.0.5",
        "vite-plugin-framer": "^1.1.0",
        "vite-plugin-mkcert": "^1.17.8"
    }
}
